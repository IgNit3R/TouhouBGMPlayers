<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================
     深色主题：色表（只放画刷，样式在 Controls.xaml）
    ============================================================
     与 Colors.Light.xaml 是契约关系：两边的 x:Key 集合必须逐一对齐，
     少一个键 = 切到另一边直接 XamlParseException（VizSelfTest 有机器校验）。
     切换时 ThemeManager 会整体换掉本文件，并让 Controls.xaml 重新
     加载一次，里面的 StaticResource 才会解析到新 Brush 实例。
     注意：本文件不许再合并任何 MergedDictionaries，每多合并一次
     就多一套 Brush 实例，切换时会只换一半。
    -->

    <!-- ================= 表面 ================= -->
    <SolidColorBrush x:Key="BgDeep"        Color="#FFEFEFF2"/>   <!-- 窗口底 -->
    <SolidColorBrush x:Key="BgPanel"       Color="#FFF7F7FA"/>   <!-- 条带、面板、下拉弹层 -->
    <SolidColorBrush x:Key="BgAltRow"      Color="#FFE8E8EC"/>   <!-- 斑马纹交替行 -->
    <SolidColorBrush x:Key="BgElevated"    Color="#FFFFFFFF"/>   <!-- 输入控件、按钮 -->
    <SolidColorBrush x:Key="BgHover"       Color="#FFE2E3E8"/>   <!-- 悬停 -->
    <SolidColorBrush x:Key="BgPressed"     Color="#FFD4D5DC"/>   <!-- 按下 -->

    <!-- ================= 描边 ================= -->
    <SolidColorBrush x:Key="Border"        Color="#FFD6D6DC"/>
    <SolidColorBrush x:Key="BorderHover"   Color="#FFBEBEC7"/>
    <SolidColorBrush x:Key="BorderFocus"   Color="#FF7A7A88"/>

    <!-- ================= 文字 ================= -->
    <SolidColorBrush x:Key="Text"          Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="TextDim"       Color="#FF5A5A66"/>
    <SolidColorBrush x:Key="TextFaint"     Color="#FF7A7A86"/>
    <!-- 波形背景网格（很淡）。与 GridLine 同值，全 app 一套网格语言。
         画在 BgDeep 上，比底深一档：浅色里网格要往下压才看得见。 -->
    <SolidColorBrush x:Key="WaveGrid"      Color="#FFDEDEE3"/>

    <!-- ================= 强调（全局唯一的一个彩色） ================= -->
    <SolidColorBrush x:Key="Accent"        Color="#FF0E639C"/>
    <SolidColorBrush x:Key="AccentText"    Color="#FFFFFFFF"/>

    <!-- ================= 语义色（低饱和） ================= -->
    <SolidColorBrush x:Key="Ok"            Color="#FF0E7C5A"/>   <!-- 路径校验通过 -->
    <SolidColorBrush x:Key="Warn"          Color="#FF8A5E10"/>   <!-- 有疑点 -->
    <SolidColorBrush x:Key="Fail"          Color="#FFB4232A"/>   <!-- 校验失败 -->
    <SolidColorBrush x:Key="Alt"           Color="#FF7B3FA0"/>   <!-- 灵界版激活态的文字与描边 -->
    <!-- 灵界版激活态的底色三档：暗紫调，思路与 RowPlaying（暗蓝调）一致 ——
         小面积元素可以比行底色亮一点，要一眼看出「已切到灵界版」。
         浅色版反转为浅紫底（EBDCF5 一档），文字 Alt 压深为 #7B3FA0。 -->
    <SolidColorBrush x:Key="AltBg"         Color="#FFEBDCF5"/>
    <SolidColorBrush x:Key="AltBgHover"    Color="#FFDCC7ED"/>
    <SolidColorBrush x:Key="AltBgPressed"  Color="#FFCDB0E2"/>

    <!-- 通用「副版切换」按钮（数据驱动，见 TrackIndex.GameDef.MainLabel / AltLabel）。
         底色取自两张 OST 封面的「紅」字（见 cover_art/记录_封面取色分析.md）：
         新典(主版) #F6C3C8 浅玫瑰 / 原典(副版) #C2534F 砖红。
         主版底色偏亮 → 文字用深色（VariantMainFg）；副版底色深 → 文字用浅色（AccentText）。
         与上面灵界版那组紫色画刷各自独立，互不影响。
         浅色版保留封面色相、整体压暗一档：#F6C3C8 放在浅面板上对比只有约 1.03，按钮会消失。 -->
    <SolidColorBrush x:Key="VariantMainBg"        Color="#FFE09AA3"/>   <!-- 主版（新典）底色 -->
    <SolidColorBrush x:Key="VariantMainBorder"    Color="#FFC8737E"/>   <!-- 主版边框（略深，浅底上才看得见） -->
    <SolidColorBrush x:Key="VariantMainBgHover"   Color="#FFD48B94"/>   <!-- 浅底按钮：hover 略深 -->
    <SolidColorBrush x:Key="VariantMainBgPressed" Color="#FFC77C86"/>   <!-- pressed 更深 -->
    <SolidColorBrush x:Key="VariantMainFg"        Color="#FF2A1014"/>   <!-- 主版文字（深，配浅底） -->
    <SolidColorBrush x:Key="VariantAltBg"         Color="#FFA63F3B"/>   <!-- 副版（原典）底色 -->
    <SolidColorBrush x:Key="VariantAltBorder"     Color="#FFB84B46"/>   <!-- 副版边框（略亮） -->
    <SolidColorBrush x:Key="VariantAltBgHover"    Color="#FFB54640"/>
    <SolidColorBrush x:Key="VariantAltBgPressed"  Color="#FFC1524C"/>

    <!-- 说明文字里的关键词强调（文件名、数值名之类）。比正文亮、比强调色淡。 -->
    <SolidColorBrush x:Key="Emphasis"      Color="#FF0E6B84"/>

    <!-- 正在播放的那一行。比选中色淡得多，不能和选中态抢，但要能从底色和斑马纹里看出来 -->
    <SolidColorBrush x:Key="RowPlaying"    Color="#FFDCEBFA"/>

    <!-- ================= 可视化（浅色下全部压暗：VizBar / VizLineL / Emphasis（右声道）都要保住浅底对比度） =================
         定稿参数见 docs/2026-09-19-research-visualization.md §7。
         VizBar  ：频谱柱、电平柱体（示波器右声道与相位指针复用 Emphasis #9CDCFE，
                   示波器左声道与利萨如、相位指针复用 VizLineL —— 同族双蓝，不引入新色相）。 -->
    <SolidColorBrush x:Key="VizBar"        Color="#FF2272B0"/>
    <!--
    波形上的标记（循环入口）。用红是为了在饱和蓝的波形上**一眼能看见** ——
    ⚠️ 别拿主题的 `Accent`（那是 #FF0E639C 深蓝，和 VizBar 撞色，试过，几乎看不见）。
    浅色版加深为 #B4232A，白底上对比约 5.7。
    -->
    <SolidColorBrush x:Key="VizMark"       Color="#FFB4232A"/>
    <SolidColorBrush x:Key="VizLineL"      Color="#FF1560A8"/>

    <!-- ================= 菜单 / 右键菜单 ================= -->
    <SolidColorBrush x:Key="MenuPopupBg"     Color="#FFFAFAFC"/>
    <SolidColorBrush x:Key="MenuPopupBorder" Color="#FFD6D6DC"/>
    <SolidColorBrush x:Key="MenuSeparator"   Color="#FFE2E2E7"/>

    <SolidColorBrush x:Key="ScrollBg"           Color="#FFEFEFF2"/>
    <SolidColorBrush x:Key="ScrollThumb"        Color="#FFA8A8B4"/>
    <SolidColorBrush x:Key="ScrollThumbHover"   Color="#FF8C8C9A"/>
    <!-- ================= 原窗口级与硬编码收编 =================
         GridLine / HeaderBg / SelectionBg 原在 MainWindow.xaml 窗口级，
         MarqueeFill 原是 MainWindow.xaml 里框选矩形的硬编码填充
         （Accent 加了 alpha 的写死版）。现在统一收进色表。 -->
    <SolidColorBrush x:Key="GridLine"     Color="#FFDEDEE3"/>
    <SolidColorBrush x:Key="HeaderBg"     Color="#FFEBEBF0"/>
    <SolidColorBrush x:Key="SelectionBg"  Color="#FFD6D6DC"/>
    <SolidColorBrush x:Key="MarqueeFill"  Color="#4A0E639C"/>
</ResourceDictionary>
