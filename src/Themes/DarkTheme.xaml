<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================
     深色主题：调色板 + 共享控件样式
    ============================================================
    设计取向：
      - 只有一套中性灰阶 + 一个强调色（蓝），不引入第二种彩色
      - 语义色（通过/疑点/失败/灵界版）压低饱和度，只在有意义的场合出现
      - 表面分 4 档，层次靠明度阶梯拉开，不靠描边和色相

    表面明度阶梯（关键）：
      17 窗口底 → 22 面板 → 2E 输入控件 → 39/43 悬停/按下
    阶梯比原来的 1E/25/33 拉得更开，但仍在中性灰范围内，不显得花。

    这里只放 ScrollBar / Button / ComboBox / ComboBoxItem 的样式。
    Slider / ToolTip / CheckBox / RadioButton / ListBox / ProgressBar
    暂未纳入（仍是系统默认），待定。
    -->

    <!-- ================= 表面 ================= -->
    <SolidColorBrush x:Key="BgDeep"        Color="#FF171717"/>   <!-- 窗口底 -->
    <SolidColorBrush x:Key="BgPanel"       Color="#FF222224"/>   <!-- 条带、面板、下拉弹层 -->
    <SolidColorBrush x:Key="BgAltRow"      Color="#FF1C1C1E"/>   <!-- 斑马纹交替行 -->
    <SolidColorBrush x:Key="BgElevated"    Color="#FF2E2E31"/>   <!-- 输入控件、按钮 -->
    <SolidColorBrush x:Key="BgHover"       Color="#FF393940"/>   <!-- 悬停 -->
    <SolidColorBrush x:Key="BgPressed"     Color="#FF43434A"/>   <!-- 按下 -->

    <!-- ================= 描边 ================= -->
    <SolidColorBrush x:Key="Border"        Color="#FF3F3F45"/>
    <SolidColorBrush x:Key="BorderHover"   Color="#FF52525A"/>
    <SolidColorBrush x:Key="BorderFocus"   Color="#FF6E6E7A"/>

    <!-- ================= 文字 ================= -->
    <SolidColorBrush x:Key="Text"          Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="TextDim"       Color="#FFADADB4"/>
    <SolidColorBrush x:Key="TextFaint"     Color="#FF71717A"/>

    <!-- ================= 强调（全局唯一的一个彩色） ================= -->
    <SolidColorBrush x:Key="Accent"        Color="#FF0E639C"/>
    <SolidColorBrush x:Key="AccentText"    Color="#FFFFFFFF"/>

    <!-- ================= 语义色（低饱和） ================= -->
    <SolidColorBrush x:Key="Ok"            Color="#FF4EC9B0"/>   <!-- 路径校验通过 -->
    <SolidColorBrush x:Key="Warn"          Color="#FFCEA86A"/>   <!-- 有疑点 -->
    <SolidColorBrush x:Key="Fail"          Color="#FFD4696B"/>   <!-- 校验失败 -->
    <SolidColorBrush x:Key="Alt"           Color="#FFB07FD0"/>   <!-- 灵界版激活态的文字与描边 -->
    <!-- 灵界版激活态的底色三档：暗紫调，思路与 RowPlaying（暗蓝调）一致 ——
         小面积元素可以比行底色亮一点，要一眼看出「已切到灵界版」。 -->
    <SolidColorBrush x:Key="AltBg"         Color="#FF3A2A4E"/>
    <SolidColorBrush x:Key="AltBgHover"    Color="#FF4A365F"/>
    <SolidColorBrush x:Key="AltBgPressed"  Color="#FF563F6E"/>

    <!-- 通用「副版切换」按钮（数据驱动，见 TrackIndex.GameDef.MainLabel / AltLabel）。
         底色取自两张 OST 封面的「紅」字（见 cover_art/记录_封面取色分析.md）：
         新典(主版) #F6C3C8 浅玫瑰 / 原典(副版) #C2534F 砖红。
         主版底色偏亮 → 文字用深色（VariantMainFg）；副版底色深 → 文字用浅色（AccentText）。
         与上面灵界版那组紫色画刷各自独立，互不影响。 -->
    <SolidColorBrush x:Key="VariantMainBg"        Color="#FFF6C3C8"/>   <!-- 主版（新典）底色 -->
    <SolidColorBrush x:Key="VariantMainBorder"    Color="#FFE0AEB4"/>   <!-- 主版边框（略深，浅底上才看得见） -->
    <SolidColorBrush x:Key="VariantMainBgHover"   Color="#FFEBB2B8"/>   <!-- 浅底按钮：hover 略深 -->
    <SolidColorBrush x:Key="VariantMainBgPressed" Color="#FFDDA0A6"/>   <!-- pressed 更深 -->
    <SolidColorBrush x:Key="VariantMainFg"        Color="#FF2A1014"/>   <!-- 主版文字（深，配浅底） -->
    <SolidColorBrush x:Key="VariantAltBg"         Color="#FFC2534F"/>   <!-- 副版（原典）底色 -->
    <SolidColorBrush x:Key="VariantAltBorder"     Color="#FFD4675F"/>   <!-- 副版边框（略亮） -->
    <SolidColorBrush x:Key="VariantAltBgHover"    Color="#FFD2605A"/>
    <SolidColorBrush x:Key="VariantAltBgPressed"  Color="#FFDE6E67"/>

    <!-- 说明文字里的关键词强调（文件名、数值名之类）。比正文亮、比强调色淡。 -->
    <SolidColorBrush x:Key="Emphasis"      Color="#FF9CDCFE"/>

    <!-- 正在播放的那一行。比选中色淡得多，不能和选中态抢，但要能从底色和斑马纹里看出来 -->
    <SolidColorBrush x:Key="RowPlaying"    Color="#FF233A4D"/>

    <!-- ================= 菜单 / 右键菜单 ================= -->
    <SolidColorBrush x:Key="MenuPopupBg"     Color="#FF242427"/>
    <SolidColorBrush x:Key="MenuPopupBorder" Color="#FF43434B"/>
    <SolidColorBrush x:Key="MenuSeparator"   Color="#FF3A3A40"/>

    <!--
    菜单弹层。默认模板的弹层背景取自 SystemColors（浅色）且带一圈浅色描边，
    在深色界面上就是一圈很扎眼的白边 —— 必须整份模板重写。
    ContextMenu 也要单独写一份：右键菜单是代码建的，用的是它自己的模板。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource MenuPopupBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MenuPopupBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <!-- AllowsTransparency 是 Popup 的属性，ContextMenu 上没有（它内部的 Popup 由 WPF 自己管）。
             能做的是关掉阴影 —— 阴影需要透明区，关掉后弹层的透明外圈就没了。 -->
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="0,3"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    菜单栏本体。默认模板带一圈系统色描边，在深色界面上就是一条没画完整的白线。
    这里显式去掉。
    -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource BgDeep}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter x:Name="HeaderHost" ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Popup x:Name="SubMenuPopup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="False" Focusable="False"
                                   UseLayoutRounding="True">
                                <Border Background="{StaticResource MenuPopupBg}"
                                        BorderBrush="{StaticResource MenuPopupBorder}"
                                        BorderThickness="1" CornerRadius="3" Padding="0,3"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 顶部菜单项：只做轻微提亮，别用强调色盖住整条菜单栏 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelHeader"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </MultiTrigger>
                        <!-- 下拉项：用强调色，和选中行的观感一致 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="SubmenuItem"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource MenuSeparator}"/>
        <Setter Property="Margin" Value="8,3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Fill="{TemplateBinding Background}" Height="1"
                               Margin="{TemplateBinding Margin}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    菜单里的分隔线走 MenuItem.SeparatorStyleKey，优先级高于上面的隐式样式 ——
    不单独写这一份，就会退回系统模板，而系统模板的线取的是 Foreground。
    我们从 ContextMenu / MenuItem 继承下来的前景色是浅色文字色，
    于是分隔线渲染成一条白线。这里把 Foreground 一并压成深色。
    -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Foreground" Value="{StaticResource MenuSeparator}"/>
        <Setter Property="Background" Value="{StaticResource MenuSeparator}"/>
    </Style>

    <!-- ================= 滚动条 ================= -->
    <SolidColorBrush x:Key="ScrollBg"           Color="#FF1B1B1D"/>
    <SolidColorBrush x:Key="ScrollThumb"        Color="#FF4A4A52"/>
    <SolidColorBrush x:Key="ScrollThumbHover"   Color="#FF5E5E68"/>

    <!--
    滚动条：只画轨道 + 滑块，去掉两端的箭头按钮（现代风格，也更省地方）。
    轨道上的空白区域做成透明 RepeatButton，点击可翻页 —— 保留了默认交互。
    -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="{StaticResource ScrollThumb}"
                            CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background"
                                    Value="{StaticResource ScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource ScrollBg}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                      Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                      Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 滑块（进度条 / 音量） =================
         默认 WPF 滑块是系统蓝轨道 + 立体滑块，在深色界面上很跳。
         这里重写：细轨道 + 圆形滑块，已过的部分用强调色填充。
         只做了水平方向 —— 目前两个滑块都是水平的。 -->

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Dot" Width="12" Height="12"
                             Fill="{StaticResource TextDim}"
                             Stroke="{StaticResource BgDeep}" StrokeThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 已滑过的那一段 -->
    <Style x:Key="SliderTrackLeft" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource Accent}" Height="4" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 未滑过的那一段（透明，露出底下的轨道） -->
    <Style x:Key="SliderTrackRight" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="TrackBg" Height="4" CornerRadius="2"
                                Background="{StaticResource BgElevated}"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackLeft}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackRight}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= 按钮（含悬停 / 按下 / 禁用） ================= -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPanel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 复选框 / 单选框 =================
         和 ComboBox 同一个坑：默认样式的 Foreground 取自系统 ControlText（黑色），
         样式 Setter 优先级高于从窗口继承的前景色，所以深色主题下文字是黑的。
         勾选框 / 圆点本身也顺手重写，不然系统浅色边框在深色底上很跳。 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                Background="{StaticResource BgElevated}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <Path x:Name="Mark" Width="10" Height="10" Stretch="Uniform"
                                      Data="M 1,5.5 L 4,8.5 L 9,1.5"
                                      Stroke="{StaticResource Text}" StrokeThickness="1.6"
                                      Visibility="Collapsed"/>
                                <Rectangle x:Name="Dash" Width="6" Height="2"
                                           Fill="{StaticResource Text}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource BgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True">
                        <Border x:Name="Dot" Width="14" Height="14" CornerRadius="7"
                                Background="{StaticResource BgElevated}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="FillDot" Width="6" Height="6"
                                     Fill="{StaticResource Text}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FillDot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource BgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 霊界版按钮（激活态） =================
         已切到灵界版时由代码给 AltButton 换上这份样式；换回主版时 ClearValue 落回上面的隐式样式。
         不能用 BasedOn 继承 —— 基类模板里的悬停/按下触发器写的是固定灰色画刷，
         会把紫色状态盖掉，所以这里整份模板自带给一套紫色状态。 -->
    <Style x:Key="AltActiveButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AltBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Alt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Alt}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AltBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AltBgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPanel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 副版切换按钮（数据驱动） =================
         播放列表行那个「新典 / 原典」按钮。两个样式共用同一份模板，只是配色不同：
         主版绯红、副版稍暗的红。由代码按 GameDef.MainLabel/AltLabel 与 UsingAlt 选一份，
         隐藏时 ClearValue。整份模板自带给一套悬停/按下/禁用状态（同 AltActiveButton 思路）。 -->
    <Style x:Key="VariantMainButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VariantMainBg}"/>
        <Setter Property="Foreground" Value="{StaticResource VariantMainFg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VariantMainBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VariantMainBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VariantMainBgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPanel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VariantAltButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource VariantAltBg}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource VariantAltBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VariantAltBgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource VariantAltBgPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPanel}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 标签页 =================
         默认模板的标签头在系统色和自定义背景之间来回切换，
         选中 / 未选中几乎看不出差别。这里整份重写：
         未选中透明 + 暗文字，悬停提亮，选中抬到 BgElevated 并加一条强调色下划线。 -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= 组合框 =================
         默认模板的弹层背景取自 SystemColors.WindowBrush（浅色），
         而 Foreground 会继承窗口的浅色前景 —— 结果是浅字压浅底，看不清。
         所以这里整份模板重写，盒体和弹层都用主题色。 -->

    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Bd" Grid.ColumnSpan="2"
                    Background="{StaticResource BgElevated}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="2"/>
            <Path x:Name="Arrow" Grid.Column="1"
                  Fill="{StaticResource TextDim}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 8 0 Z"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocus}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgPanel}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextFaint}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource BgElevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleButton}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="7,0,22,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="False"
                               Focusable="False"
                               UseLayoutRounding="True"
                               MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border x:Name="DropDownBorder"
                                    Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource BorderHover}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,2,0,0"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    下拉项。IsAvailable 是 PlaylistItem 的属性 —— 未配置路径的作品灰显。
    绑定在其他数据上下文上会静默失败（取不到值），触发器不生效，正好是我们要的。
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            </DataTrigger>
            <!-- 高亮放最后：即使是不可用的项，指到它时也要能看清 -->
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
