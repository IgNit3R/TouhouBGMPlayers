<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 只为用 FolderBrowserDialog（文件夹选择）。WPF 自身没有文件夹选择对话框。 -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>ThbgmPlayer</AssemblyName>
    <RootNamespace>ThbgmPlayer</RootNamespace>

    <!-- 曲名是日语，源码与资源统一 UTF-8 -->
    <CodePage>65001</CodePage>
    <!-- 不做单文件发布：自解压到临时目录会破坏"一个文件夹跑"的便携性 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 框架依赖，不自带运行时，产物就是几个 dll -->
    <SelfContained>false</SelfContained>

    <!-- 程序集/文件版本必须是纯数字；给人看的版本号走 InformationalVersion（可带字母）。
         「关于」对话框读的就是 InformationalVersion。 -->
    <Version>1.3.0</Version>
    <InformationalVersion>1.3k</InformationalVersion>
    <!-- SDK 默认会把 git 提交哈希追加到 InformationalVersion 后面（Source Revision ID，
         溯源用）。播放器版本号是给人看的，那串哈希纯属噪音，关掉。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>ThbgmPlayer</Company>
    <Product>东方 Project BGM 播放器</Product>

    <!-- exe 图标（资源管理器里看到的）。多尺寸 .ico 由 tools/make_icon.py 生成 -->
    <ApplicationIcon>..\assets\icon\bgmplayer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 在 UseWindowsForms=true 时自动注入 `global using System.Windows.Forms;` 和
         `global using System.Drawing;`，会和 WPF 的 Application / Brush / Color / Point / Size
         等撞名（CS0104）。这里摘掉这两条全局注入 —— 代码里凡是要用 WinForms 的地方
         一律写全称（目前只有 FolderBrowserDialog 一处）。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <!-- OGG 解码。⚠️ 不要换回 NVorbis 0.10.x / 1.0.x：它们解码黄昏作的 OGG 时会丢 1024 样本块
         （页结构很碎：每页 22~29 个包且几乎每页跨页包），造成整轨漂移，循环点随之错位。
         VorbisPizza 是 NVorbis 的现代分支（命名空间仍是 NVorbis），同样纯托管、MIT 许可，
         且解码结果与 libvorbis / libsndfile 逐样本一致（已实测 100%）。
         不用 libvorbis P/Invoke 是为了保住"一个文件夹跑"的便携性（不引入原生 DLL）。 -->
    <PackageReference Include="VorbisPizza" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 黄昏作容器解析器库（addons/ 下 75/75 项真机验证通过的移植）。
         单开类库工程是因为解析器源码依赖 ImplicitUsings 的 System.IO，
         而 WPF 主工程主动摘除了它 —— 解析器源码保持零改动。 -->
    <ProjectReference Include="..\addons\addons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把构建时间写进程序集元数据，供「关于」对话框读取。
         不能读 PE 头的时间戳：确定性编译（SDK 默认开启）下那是内容哈希，不是真实时间。
         也不能读 exe 的修改时间：那可能是复制时间。 -->
    <AssemblyMetadata Include="BuildTimestamp"
                      Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌曲目索引。指定 LogicalName，代码里按 "tracks.json.gz" 取，不受目录结构影响。
         数据源：data/tracklist.csv（346 条，含 13 首 TH13 灵界版）
         生成：tools/csv_to_tracksjson.py -->
    <EmbeddedResource Include="Resources\tracks.json.gz" LogicalName="tracks.json.gz" />

    <!-- 黄昏作曲目索引。数据源：tf_prep/*_tracklist_final.csv（230 条，7 部黄昏作）
         生成：tools/csv_to_tfjson.py。缺这个资源不报错（TrackIndex 静默跳过）。 -->
    <EmbeddedResource Include="Resources\tracks.tf.json.gz" LogicalName="tracks.tf.json.gz" Condition="Exists('Resources\tracks.tf.json.gz')" />

    <!-- TFPK v1（th145/th155）与 th175 cga 的条目真名不在容器里，需按 fileslist 哈希反查。
         内嵌社区名单（tools/135tk 同源），TfContainerSet 依次找：游戏目录 → 内嵌资源。 -->
    <EmbeddedResource Include="Resources\TfFileslist.txt" LogicalName="TfFileslist.txt" />
    <EmbeddedResource Include="Resources\TfFileslist.js" LogicalName="TfFileslist.js" />

    <!-- 窗口图标（标题栏 / 任务栏 / Alt+Tab）。以 Resource 形式打进程序集，
         XAML 里按 "Resources/bgmplayer.ico" 这个 pack 相对路径引用（Link 决定包内路径）。 -->
    <Resource Include="..\assets\icon\bgmplayer.ico">
      <Link>Resources\bgmplayer.ico</Link>
    </Resource>
  </ItemGroup>

</Project>
