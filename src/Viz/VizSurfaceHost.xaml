<UserControl x:Class="ThbgmPlayer.Viz.VizSurfaceHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viz="clr-namespace:ThbgmPlayer.Viz"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
    ============================================================
    五块可视化区域：A 频谱条 / B 示波器 / C+J 电平与相位 / D 利萨如 / 封面占位。

    为什么单开一个控件：**要有两处宿主** —— 贴附（或自由）的附件窗口，以及
    主窗口最大化时嵌进去的那一块（方案 §十）。两处的内容必须完全一样，
    所以布局只能有一份，不能复制。

    它**不含状态条**：那是附件窗口特有的（调试声源报错用），内嵌时没有它的位置。

    分区比例（方案 §2 已拍板）：
      · 两组高度 2.3 : 1
      · 第一组左右 7 : 3（左列 A 上 / B 下等分）
      · 第二组左右平分（D ｜ 封面）
    ⚠️ 布局自检要读这些 RowDefinition/ColumnDefinition 的实际尺寸，
    所以几个容器保留 x:Name。
    ============================================================
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2.3*"/>    <!-- 第一组：左 A/B ｜ 右 C+J -->
            <RowDefinition Height="1*"/>      <!-- 第二组：D ｜ 封面 -->
        </Grid.RowDefinitions>

        <!-- ==================== 第一组 ==================== -->
        <!-- x:Name 只为布局自检服务（要读 ColumnDefinition/RowDefinition 的实际尺寸） -->
        <Grid x:Name="GroupFirst" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>   <!-- 左列：A 上 / B 下 -->
                <ColumnDefinition Width="3*"/>   <!-- 右列：C + J -->
            </Grid.ColumnDefinitions>

            <!-- 左列：A 上 / B 下。行定义在**这里**，不在 GroupFirst 上（那个只有列定义） -->
            <Grid x:Name="LeftColumn" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- A 频谱条：52 根对数频柱，20Hz–20kHz，无峰值帽 -->
                <Border Grid.Row="0" Style="{StaticResource VizCell}">
                    <viz:VizPanel x:Name="PanelA"/>
                </Border>

                <!--
                B 示波器：约 12ms 窗口，上下分屏 L / R。
                VizCell 那层 Border 保留 —— 它给的是外边距与描边，面板只画内容、不碰边框。
                -->
                <Border Grid.Row="1" Style="{StaticResource VizCell}">
                    <viz:VizPanel x:Name="PanelB"/>
                </Border>
            </Grid>

            <!-- C 电平 + J 相位相关：同一块面板，J 横条挂在电平柱下方 -->
            <Border Grid.Column="1" Style="{StaticResource VizCell}">
                <viz:VizPanel x:Name="PanelCJ"/>
            </Border>
        </Grid>

        <!-- ==================== 第二组 ==================== -->
        <Grid x:Name="GroupSecond" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- D 利萨如：(L,R) 散点 + 余辉。唯一带状态的渲染器，见 LissajousRenderer 注释。 -->
            <Border Grid.Column="0" Style="{StaticResource VizCell}">
                <viz:VizPanel x:Name="PanelD"/>
            </Border>

            <!--
            封面预留：来源之后作（另一条支线），这里只是一个虚线空框 + 灰字，
            不加载任何图片、不做占位图 —— 先把位置和观感定下来（方案 §2）。
            x:Name 供设置里的「封面」开关切可见性（面板开关走「无渲染器 = 空白」那一条路，
            但封面不是 VizPanel，只能切可见性）。
            -->
            <Grid x:Name="CoverCell" Grid.Column="1">
                <Rectangle Stroke="{StaticResource Border}" StrokeThickness="1"
                           Margin="2" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource BgPanel}"/>
                <Rectangle Stroke="{StaticResource TextFaint}" StrokeThickness="1"
                           StrokeDashArray="4 3" Opacity="0.55"
                           Margin="12" RadiusX="2" RadiusY="2"/>
                <TextBlock Text="封面"
                           Foreground="{StaticResource TextFaint}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
